# Public dashboard configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only worker access. Never expose this value to the browser.
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
# Legacy projects may use SUPABASE_SERVICE_ROLE_KEY instead.

# Standalone monitoring worker. SUPABASE_URL may be used instead of the public URL.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_DB_PASSWORD=your-database-password
MONITOR_WORKER_ID=local-worker
MONITOR_BATCH_SIZE=25
MONITOR_CONCURRENCY=5
MONITOR_POLL_INTERVAL_MS=5000
MONITOR_LEASE_SECONDS=45
MONITOR_HEARTBEAT_INTERVAL_MS=30000
MONITOR_HEALTH_MAX_AGE_MS=90000
CHECK_RESULT_RETENTION_DAYS=30
NOTIFICATION_BATCH_SIZE=10
NOTIFICATION_CONCURRENCY=3

# Added in the notification phase.
RESEND_API_KEY=re_placeholder
RESEND_FROM_EMAIL=monitor@example.com
TELEGRAM_BOT_TOKEN=placeholder

# Test-only values must point to isolated local services.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
